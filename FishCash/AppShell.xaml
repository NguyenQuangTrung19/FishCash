<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FishCash.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FishCash"
    xmlns:views="clr-namespace:FishCash.Views"
    Title="FishCash"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource PageBg}, Dark={StaticResource PageBgDark}}"
    FlyoutWidth="280">

    <!-- Flyout Header -->
    <Shell.FlyoutHeader>
        <Grid HeightRequest="120" 
              BackgroundColor="{AppThemeBinding Light={StaticResource HeaderBg}, Dark={StaticResource HeaderBgDark}}"
              Padding="20">
            <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                <Label Text="🐟 FishCash" 
                       FontSize="26" 
                       FontAttributes="Bold" 
                       TextColor="White"/>
                <Label Text="Quản lý cửa hàng hải sản" 
                       FontSize="13" 
                       TextColor="#7dd3fc"/>
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Tổng quan (Dashboard)">
        <ShellContent
            ContentTemplate="{DataTemplate views:DashboardPage}"
            Route="DashboardPage" />
    </FlyoutItem>

    <FlyoutItem Title="Máy tính tiền (POS)">
        <ShellContent
            ContentTemplate="{DataTemplate views:PosPage}"
            Route="PosPage" />
    </FlyoutItem>

    <FlyoutItem Title="Danh mục">
        <ShellContent
            ContentTemplate="{DataTemplate views:CategoryPage}"
            Route="CategoryPage" />
    </FlyoutItem>
    
    <FlyoutItem Title="Sản phẩm">
        <ShellContent
            ContentTemplate="{DataTemplate views:ProductPage}"
            Route="ProductPage" />
    </FlyoutItem>

</Shell>
