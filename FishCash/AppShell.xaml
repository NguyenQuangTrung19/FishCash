<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FishCash.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FishCash"
    xmlns:views="clr-namespace:FishCash.Views"
    Title="FishCash">

    <FlyoutItem Title="Máy tính tiền (POS)" Icon="dotnet_bot.png">
        <ShellContent
            ContentTemplate="{DataTemplate views:PosPage}"
            Route="PosPage" />
    </FlyoutItem>

    <FlyoutItem Title="Danh mục" Icon="dotnet_bot.png">
        <ShellContent
            ContentTemplate="{DataTemplate views:CategoryPage}"
            Route="CategoryPage" />
    </FlyoutItem>
    
    <FlyoutItem Title="Sản phẩm" Icon="dotnet_bot.png">
        <ShellContent
            ContentTemplate="{DataTemplate views:ProductPage}"
            Route="ProductPage" />
    </FlyoutItem>

</Shell>
