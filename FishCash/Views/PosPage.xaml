<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FishCash.ViewModels"
             x:DataType="viewmodels:PosViewModel"
             x:Class="FishCash.Views.PosPage"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBg}, Dark={StaticResource PageBgDark}}">

    <Grid ColumnDefinitions="2*, 1*" ColumnSpacing="10" Padding="15">
        
        <!-- Cột trái: Danh sách Sản phẩm -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *">
            <Label Grid.Row="0" Text="🐟 Mặt hàng" Style="{StaticResource PageHeader}" FontSize="26"/>
            
            <RefreshView Grid.Row="1" Command="{Binding LoadProductsCommand}" IsRefreshing="{Binding IsBusy}">
                <CollectionView ItemsSource="{Binding Products}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="10" HorizontalItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource CardFrame}" Padding="15">
                                <Grid RowDefinitions="Auto, Auto, Auto">
                                    <Label Grid.Row="0" Text="{Binding Name}" Style="{StaticResource ProductName}"/>
                                    <Label Grid.Row="1" Text="{Binding Category.Name}" Style="{StaticResource SubText}" Margin="0,5,0,0"/>
                                    
                                    <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,15,0,0" VerticalOptions="End">
                                        <Label Grid.Column="0" 
                                               Text="{Binding Price, StringFormat='{0:N0} đ'}" 
                                               Style="{StaticResource PriceLabel}" 
                                               VerticalOptions="Center"/>
                                        <Button Grid.Column="1" 
                                                Text="+" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PosViewModel}}, Path=AddToCartCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource SuccessButton}"
                                                WidthRequest="40"
                                                HeightRequest="40"/>
                                    </Grid>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- Cột phải: Giỏ hàng & Thanh toán -->
        <Frame Grid.Column="1" HasShadow="False" CornerRadius="12" Padding="0" 
               BackgroundColor="{AppThemeBinding Light={StaticResource SidebarBg}, Dark={StaticResource SidebarBgDark}}"
               BorderColor="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}">
            <Grid RowDefinitions="Auto, *, Auto">
                
                <Frame Grid.Row="0" Style="{StaticResource CartHeaderFrame}">
                    <Label Text="🛒 Giỏ Hàng" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                </Frame>

                <CollectionView Grid.Row="1" ItemsSource="{Binding CartService.Items}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*, Auto, Auto" Padding="10" Margin="0,0,0,5" 
                                  BackgroundColor="{AppThemeBinding Light={StaticResource CardBg}, Dark={StaticResource CardBgDark}}">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <Label Text="{Binding Product.Name}" FontAttributes="Bold" 
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                    <Label Text="{Binding SubTotal, StringFormat='{0:N0} đ'}" 
                                           Style="{StaticResource PriceLabel}" FontSize="13"/>
                                </VerticalStackLayout>

                                <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" 
                                       FontAttributes="Bold" VerticalOptions="Center" Margin="10,0"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>

                                <Button Grid.Column="2"
                                        Text="✕"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PosViewModel}}, Path=RemoveFromCartCommand}"
                                        CommandParameter="{Binding Product}"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                        FontSize="16"
                                        WidthRequest="36" HeightRequest="36"
                                        Padding="0"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Footer Checkout -->
                <Frame Grid.Row="2" 
                       BackgroundColor="{AppThemeBinding Light={StaticResource CardBg}, Dark={StaticResource CardBgDark}}" 
                       BorderColor="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}" 
                       CornerRadius="10" Padding="20" HasShadow="False">
                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Tổng cộng:" FontSize="18" 
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                            <Label Grid.Column="1" 
                                   Text="{Binding TotalAmount, StringFormat='{0:N0} VNĐ'}" 
                                   Style="{StaticResource PriceLabelLarge}"/>
                        </Grid>

                        <Button Text="💳 Thanh Toán" 
                                Command="{Binding CheckoutCommand}"
                                Style="{StaticResource CheckoutButton}"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>
