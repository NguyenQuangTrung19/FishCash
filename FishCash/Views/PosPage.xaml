<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FishCash.ViewModels"
             xmlns:models="clr-namespace:FishCash.Models"
             x:DataType="viewmodels:PosViewModel"
             x:Class="FishCash.Views.PosPage"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBg}, Dark={StaticResource PageBgDark}}">

    <Grid>
        <!-- ═══ Main Content ═══ -->
        <Grid ColumnDefinitions="2*, 1*" ColumnSpacing="0" Padding="0">
            
            <!-- Left: Product Catalog -->
            <Grid Grid.Column="0" RowDefinitions="Auto, *" Padding="20">
                <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                    <Label Text="🐟 Mặt hàng" Style="{StaticResource PageHeader}"/>
                    <Label Text="Chọn sản phẩm để thêm vào giỏ" Style="{StaticResource SubText}" FontSize="13"/>
                </VerticalStackLayout>
                
                <RefreshView Grid.Row="1" Command="{Binding LoadProductsCommand}" IsRefreshing="{Binding IsBusy}">
                    <CollectionView ItemsSource="{Binding Products}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="12" HorizontalItemSpacing="12"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Product">
                                <Border Style="{StaticResource CardFrame}" Padding="16">
                                    <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="4">
                                        <!-- Category Badge -->
                                        <Border Grid.Row="0" 
                                                Style="{StaticResource BadgeBorder}"
                                                HorizontalOptions="Start"
                                                Margin="0,0,0,6">
                                            <Label Text="{Binding Category.Name}" Style="{StaticResource BadgeLabel}" FontSize="11"/>
                                        </Border>
                                        
                                        <!-- Product Name -->
                                        <Label Grid.Row="1" Text="{Binding Name}" Style="{StaticResource ProductName}"/>
                                        
                                        <!-- Price + Unit + Add Button -->
                                        <Grid Grid.Row="3" ColumnDefinitions="*, Auto" Margin="0,10,0,0" VerticalOptions="End">
                                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                                <Label Text="{Binding Price, StringFormat='{0:N0} đ'}" 
                                                       Style="{StaticResource PriceLabel}" 
                                                       FontSize="17"/>
                                                <Label Text="{Binding Unit, StringFormat='/{0}'}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" 
                                                    Text="+" 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PosViewModel}}, Path=AddToCartCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource SuccessButton}"
                                                    CornerRadius="12"
                                                    WidthRequest="44"
                                                    HeightRequest="44"
                                                    FontSize="22"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        
                        <CollectionView.EmptyView>
                            <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="30">
                                <Label Text="🐠" FontSize="48" HorizontalOptions="Center"/>
                                <Label Text="Chưa có sản phẩm" Style="{StaticResource EmptyViewLabel}"/>
                            </StackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </RefreshView>
            </Grid>

            <!-- Right: Cart Sidebar -->
            <Border Grid.Column="1" 
                    StrokeShape="RoundRectangle 0"
                    Stroke="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBg}, Dark={StaticResource CardBgDark}}"
                    Padding="0">
                <Grid RowDefinitions="Auto, Auto, *, Auto">
                    
                    <!-- Cart Header -->
                    <Grid Grid.Row="0" Padding="20,18" HeightRequest="65">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource GradientStart}" Offset="0.0" />
                                <GradientStop Color="{StaticResource GradientEnd}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Label Text="🛒 Giỏ Hàng" TextColor="White" FontSize="20" FontAttributes="Bold" 
                               VerticalOptions="Center"/>
                    </Grid>

                    <!-- Display Unit Selector -->
                    <Grid Grid.Row="1" Padding="16,10" ColumnDefinitions="Auto, *"
                          BackgroundColor="{AppThemeBinding Light=#f0f9ff, Dark=#0c4a6e}">
                        <Label Grid.Column="0" Text="⚖️ Đơn vị chung:" 
                               FontSize="13" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0369a1, Dark=#7dd3fc}"
                               VerticalOptions="Center" Margin="0,0,8,0"/>
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light=#bae6fd, Dark=#075985}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#0c4a6e}"
                                Padding="8,2" HeightRequest="36">
                            <Picker ItemsSource="{Binding DisplayUnitOptions}" 
                                    SelectedItem="{Binding DisplayUnit}"
                                    FontSize="13"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                    <!-- Cart Items -->
                    <CollectionView Grid.Row="2" ItemsSource="{Binding CartService.Items}" Margin="0,5,0,0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CartItem">
                                <Grid Padding="16,10" BackgroundColor="Transparent">
                                    <Grid ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="6">
                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="3">
                                            <Label Text="{Binding Product.Name}" FontAttributes="Bold" FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                   LineBreakMode="TailTruncation" MaxLines="1"/>
                                            <Label FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0:N1} {1} × {2:N0} đ/{1}">
                                                        <Binding Path="ConvertedQuantity"/>
                                                        <Binding Path="DisplayUnit"/>
                                                        <Binding Path="UnitPriceConverted"/>
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                            <Label Text="{Binding SubTotal, StringFormat='{0:N0} đ'}" 
                                                   Style="{StaticResource PriceLabel}" FontSize="13"/>
                                        </VerticalStackLayout>

                                        <!-- Quantity Badge -->
                                        <Border Grid.Column="1" 
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark=#164e63}"
                                                Padding="8,5"
                                                VerticalOptions="Center"
                                                Margin="4,0">
                                            <Label FontAttributes="Bold" FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                   HorizontalOptions="Center">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0:G} {1}">
                                                        <Binding Path="EnteredQuantity"/>
                                                        <Binding Path="EnteredUnit"/>
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </Border>

                                        <!-- Edit Button -->
                                        <Button Grid.Column="2"
                                                Text="✏️"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PosViewModel}}, Path=EditCartItemCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent"
                                                FontSize="14"
                                                WidthRequest="32" HeightRequest="32"
                                                Padding="0"
                                                ToolTipProperties.Text="Sửa số lượng"/>

                                        <!-- Remove Button -->
                                        <Button Grid.Column="3"
                                                Text="✕"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PosViewModel}}, Path=RemoveFromCartCommand}"
                                                CommandParameter="{Binding Product}"
                                                BackgroundColor="Transparent"
                                                TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                                FontSize="14"
                                                WidthRequest="32" HeightRequest="32"
                                                Padding="0"
                                                ToolTipProperties.Text="Xóa"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        
                        <CollectionView.EmptyView>
                            <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="20">
                                <Label Text="🛒" FontSize="36" HorizontalOptions="Center" Opacity="0.4"/>
                                <Label Text="Giỏ hàng trống" FontSize="14" HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                            </StackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <!-- Footer Checkout -->
                    <Grid Grid.Row="3" RowDefinitions="Auto, Auto" Padding="20,16" RowSpacing="14"
                          BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                        
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Tổng cộng" FontSize="16" 
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1" 
                                   Text="{Binding TotalAmount, StringFormat='{0:N0} VNĐ'}" 
                                   Style="{StaticResource PriceLabelLarge}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <Button Grid.Row="1" Text="💳 Thanh Toán" 
                                Command="{Binding CheckoutCommand}"
                                Style="{StaticResource CheckoutButton}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Quantity Input Modal ═══ -->
        <Grid IsVisible="{Binding IsQuantityModalVisible}" 
              InputTransparent="False"
              ZIndex="100">

            <!-- Dark Backdrop -->
            <BoxView Color="#80000000" InputTransparent="False">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CancelQuantityModalCommand}"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Modal Sheet -->
            <Border Stroke="{AppThemeBinding Light=#e2e8f0, Dark=#334155}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1e293b}"
                    Padding="44"
                    MinimumWidthRequest="500"
                    MaximumWidthRequest="600"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Shadow="{OnPlatform Default={Shadow Brush=#30000000, Offset='0,12', Radius=40, Opacity=0.6}}">
                <VerticalStackLayout Spacing="24">

                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" 
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#ecfdf5, Dark=#064e3b}"
                                WidthRequest="48" HeightRequest="48"
                                Padding="0">
                            <Label Text="📦" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="14,0,0,0" VerticalOptions="Center">
                            <Label Text="{Binding PendingProduct.Name}" 
                                   FontSize="18" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0f172a, Dark=#f1f5f9}"
                                   LineBreakMode="TailTruncation" MaxLines="1"/>
                            <Label FontSize="12"
                                   TextColor="{AppThemeBinding Light=#64748b, Dark=#94a3b8}">
                                <Label.Text>
                                    <MultiBinding StringFormat="Giá gốc: {0:N0} đ/{1}">
                                        <Binding Path="PendingProduct.Price"/>
                                        <Binding Path="PendingProduct.Unit"/>
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </VerticalStackLayout>

                        <Button Grid.Column="2"
                                Text="✕"
                                Command="{Binding CancelQuantityModalCommand}"
                                BackgroundColor="{AppThemeBinding Light=#f1f5f9, Dark=#334155}"
                                TextColor="{AppThemeBinding Light=#94a3b8, Dark=#64748b}"
                                FontSize="15"
                                CornerRadius="22"
                                WidthRequest="40" HeightRequest="40"
                                Padding="0"
                                VerticalOptions="Start"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#e2e8f0, Dark=#334155}"/>

                    <!-- Quantity + Unit Row -->
                    <Grid ColumnDefinitions="2*, *" ColumnSpacing="16">
                        <VerticalStackLayout Grid.Column="0" Spacing="8">
                            <Label Text="Số lượng" 
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#cbd5e1}"/>
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light=#e2e8f0, Dark=#475569}"
                                    StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light=#f8fafc, Dark=#0f172a}"
                                    HeightRequest="56" Padding="16,0">
                                <Entry Placeholder="VD: 4.2" 
                                       Keyboard="Numeric"
                                       Text="{Binding PendingQuantityText}" 
                                       BackgroundColor="Transparent"
                                       FontSize="18"
                                       VerticalOptions="Center"
                                       PlaceholderColor="{AppThemeBinding Light=#94a3b8, Dark=#475569}"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="Đơn vị" 
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#cbd5e1}"/>
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light=#e2e8f0, Dark=#475569}"
                                    StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light=#f8fafc, Dark=#0f172a}"
                                    MinimumHeightRequest="56" Padding="16,8">
                                <Picker ItemsSource="{Binding EntryUnitOptions}" 
                                        SelectedItem="{Binding PendingUnit}"
                                        FontSize="16"
                                        BackgroundColor="Transparent"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#e2e8f0, Dark=#334155}" Margin="0,4,0,0"/>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Text="Hủy"
                                Command="{Binding CancelQuantityModalCommand}"
                                BackgroundColor="{AppThemeBinding Light=#f1f5f9, Dark=#334155}"
                                TextColor="{AppThemeBinding Light=#475569, Dark=#cbd5e1}"
                                CornerRadius="14"
                                HeightRequest="50"
                                Padding="28,0"
                                FontSize="15"/>
                        <Button Grid.Column="2"
                                Command="{Binding ConfirmAddToCartCommand}"
                                Style="{StaticResource SuccessButton}"
                                CornerRadius="14"
                                HeightRequest="50"
                                Padding="32,0"
                                FontSize="15"
                                FontAttributes="Bold">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsEditingCartItem}" Value="False">
                                    <Setter Property="Text" Value="🛒 Thêm vào giỏ"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding IsEditingCartItem}" Value="True">
                                    <Setter Property="Text" Value="✏️ Cập nhật"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
