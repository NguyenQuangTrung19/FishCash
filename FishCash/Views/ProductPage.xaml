<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FishCash.ViewModels"
             x:DataType="viewmodels:ProductViewModel"
             x:Class="FishCash.Views.ProductPage"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBg}, Dark={StaticResource PageBgDark}}">

    <Grid RowDefinitions="Auto, Auto, *" Padding="20">
        
        <!-- Header -->
        <Label Text="🦐 Kho Hải sản" Style="{StaticResource PageHeader}"/>

        <!-- Form Add Product -->
        <Frame Grid.Row="1" Style="{StaticResource CardFrame}" Margin="0,0,0,20">
            <VerticalStackLayout Spacing="15">
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="15">
                    <!-- Tên SP -->
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Tên sản phẩm" Style="{StaticResource FormLabel}"/>
                        <Entry Placeholder="VD: Mực ống tươi..." Text="{Binding NewProductName}" />
                    </VerticalStackLayout>
                    
                    <!-- Giá -->
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Giá bán (VNĐ)" Style="{StaticResource FormLabel}"/>
                        <Entry Placeholder="150000" Keyboard="Numeric" Text="{Binding NewProductPrice}" />
                    </VerticalStackLayout>

                    <!-- Danh mục -->
                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="Danh mục" Style="{StaticResource FormLabel}"/>
                        <Picker ItemsSource="{Binding Categories}" 
                                ItemDisplayBinding="{Binding Name}" 
                                SelectedItem="{Binding SelectedCategory}" 
                                Title="Chọn danh mục" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">
                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <Label Text="Đơn vị tính:" VerticalOptions="Center" 
                               Style="{StaticResource SubText}" FontSize="14"/>
                        <Entry Text="{Binding NewProductUnit}" WidthRequest="80" HorizontalOptions="Start"/>
                    </HorizontalStackLayout>
                    
                    <Button Grid.Column="1" 
                            Text="+ Nhập Kho" 
                            Command="{Binding AddProductCommand}"
                            Style="{StaticResource InfoButton}"
                            Padding="30,12"/>
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <!-- Product List -->
        <RefreshView Grid.Row="2" Command="{Binding LoadDataCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Products}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource CardFrameFlat}">
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="5">
                                    <Label Text="{Binding Name}" Style="{StaticResource ProductName}"/>
                                    <HorizontalStackLayout Spacing="10">
                                        <Frame Style="{StaticResource BadgeFrame}">
                                            <Label Text="{Binding Category.Name}" Style="{StaticResource BadgeLabel}"/>
                                        </Frame>
                                        <Label Text="{Binding Price, StringFormat='{0:N0} VNĐ'}" 
                                               Style="{StaticResource PriceLabel}" 
                                               FontSize="14" VerticalOptions="Center"/>
                                        <Label Text="{Binding Unit, StringFormat='/ {0}'}" 
                                               Style="{StaticResource SubText}" 
                                               FontSize="14" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
