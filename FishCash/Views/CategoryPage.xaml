<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FishCash.ViewModels"
             x:DataType="viewmodels:CategoryViewModel"
             x:Class="FishCash.Views.CategoryPage"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBg}, Dark={StaticResource PageBgDark}}">

    <Grid RowDefinitions="Auto, Auto, *" Padding="20">
        <!-- Page Header -->
        <Label Text="🐟 Danh mục Hải sản" Style="{StaticResource PageHeader}"/>

        <!-- Form thêm mới -->
        <Frame Grid.Row="1" Style="{StaticResource CardFrame}" Margin="0,0,0,20">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">
                <Entry Grid.Column="0" 
                       Placeholder="Nhập tên danh mục mới..." 
                       Text="{Binding NewCategoryName}"
                       FontSize="16"
                       VerticalOptions="Center"/>
                <Button Grid.Column="1" 
                        Text="+ Thêm Danh mục" 
                        Command="{Binding AddCategoryCommand}"
                        Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Frame>

        <!-- Danh sách -->
        <RefreshView Grid.Row="2" Command="{Binding LoadCategoriesCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Categories}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource CardFrameFlat}">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                                <Frame Grid.Column="0" 
                                       WidthRequest="44" HeightRequest="44" 
                                       CornerRadius="22" 
                                       Padding="0"
                                       HasShadow="False"
                                       BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark=#164e63}">
                                    <Label Text="🐠" FontSize="20" 
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Frame>
                                <Label Grid.Column="1" 
                                       Text="{Binding Name}" 
                                       Style="{StaticResource ProductName}"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                
                <CollectionView.EmptyView>
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                        <Label Text="🏝️" FontSize="48" HorizontalOptions="Center"/>
                        <Label Text="Chưa có danh mục nào" Style="{StaticResource EmptyViewLabel}"/>
                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
