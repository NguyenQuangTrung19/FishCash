<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FishCash.ViewModels"
             xmlns:models="clr-namespace:FishCash.Models"
             x:DataType="viewmodels:CategoryViewModel"
             x:Class="FishCash.Views.CategoryPage"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBg}, Dark={StaticResource PageBgDark}}">

    <Grid>
        <!-- ═══ Main Content Layer ═══ -->
        <Grid RowDefinitions="Auto, *" Padding="24">
            
            <!-- Header + Add Button -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="📁 Danh mục Hải sản" Style="{StaticResource PageHeader}"/>
                    <Label Text="Quản lý các nhóm sản phẩm" Style="{StaticResource SubText}" FontSize="13"/>
                </VerticalStackLayout>
                <Button Grid.Column="1" 
                        Text="＋ Thêm danh mục"
                        Command="{Binding ToggleFormCommand}"
                        Style="{StaticResource PrimaryButton}"
                        VerticalOptions="Center"
                        Padding="20,12"
                        CornerRadius="12"
                        FontSize="14"/>
            </Grid>

            <!-- Category List -->
            <RefreshView Grid.Row="1" Command="{Binding LoadCategoriesCommand}" IsRefreshing="{Binding IsBusy}">
                <CollectionView ItemsSource="{Binding Categories}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Category">
                            <Border Style="{StaticResource CardFrameFlat}">
                                <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="14" VerticalOptions="Center">
                                    <!-- Icon -->
                                    <Border Grid.Column="0" 
                                            Style="{StaticResource IconCircle}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark=#164e63}">
                                        <Label Text="🐠" FontSize="20" 
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    
                                    <!-- Name + Description -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Name}" 
                                               Style="{StaticResource ProductName}"
                                               VerticalOptions="Center"/>
                                        <Label Text="{Binding Description}" 
                                               Style="{StaticResource SubText}"
                                               IsVisible="{Binding Description, Converter={x:Null}}"
                                               FontSize="12"/>
                                    </VerticalStackLayout>

                                    <!-- Edit Button -->
                                    <Button Grid.Column="2"
                                            Text="✏️"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoryViewModel}}, Path=EditCategoryCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"
                                            FontSize="16"
                                            WidthRequest="40" HeightRequest="40"
                                            Padding="0"
                                            ToolTipProperties.Text="Chỉnh sửa"/>

                                    <!-- Delete Button -->
                                    <Button Grid.Column="3"
                                            Text="🗑️"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoryViewModel}}, Path=DeleteCategoryCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"
                                            FontSize="16"
                                            WidthRequest="40" HeightRequest="40"
                                            Padding="0"
                                            ToolTipProperties.Text="Xóa"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    
                    <CollectionView.EmptyView>
                        <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="40">
                            <Label Text="🏝️" FontSize="48" HorizontalOptions="Center"/>
                            <Label Text="Chưa có danh mục nào" Style="{StaticResource EmptyViewLabel}"/>
                            <Label Text="Nhấn nút '＋ Thêm danh mục' để bắt đầu" 
                                   Style="{StaticResource SubText}" HorizontalOptions="Center"/>
                        </StackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- ═══ Modal Overlay Layer ═══ -->
        <Grid IsVisible="{Binding IsFormVisible}" 
              InputTransparent="False"
              ZIndex="100">

            <!-- Dark Backdrop -->
            <BoxView Color="#80000000"
                     InputTransparent="False">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleFormCommand}"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Modal Sheet -->
            <Border Stroke="{AppThemeBinding Light=#e2e8f0, Dark=#334155}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1e293b}"
                    Padding="52"
                    MinimumWidthRequest="700"
                    MaximumWidthRequest="900"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Shadow="{OnPlatform Default={Shadow Brush=#30000000, Offset='0,12', Radius=40, Opacity=0.6}}">
                <VerticalStackLayout Spacing="28">
                    
                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" 
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#eef2ff, Dark=#312e81}"
                                WidthRequest="52" HeightRequest="52"
                                Padding="0">
                            <Label FontSize="24" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsEditing}" Value="False">
                                        <Setter Property="Text" Value="📁"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Text" Value="✏️"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="16,0,0,0" VerticalOptions="Center">
                            <Label FontSize="22" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0f172a, Dark=#f1f5f9}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsEditing}" Value="False">
                                        <Setter Property="Text" Value="Thêm danh mục mới"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Text" Value="Chỉnh sửa danh mục"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="Điền đầy đủ thông tin danh mục bên dưới" 
                                   TextColor="{AppThemeBinding Light=#64748b, Dark=#94a3b8}" FontSize="13"/>
                        </VerticalStackLayout>

                        <Button Grid.Column="2"
                                Text="✕"
                                Command="{Binding ToggleFormCommand}"
                                BackgroundColor="{AppThemeBinding Light=#f1f5f9, Dark=#334155}"
                                TextColor="{AppThemeBinding Light=#94a3b8, Dark=#64748b}"
                                FontSize="15"
                                CornerRadius="22"
                                WidthRequest="44" HeightRequest="44"
                                Padding="0"
                                VerticalOptions="Start"/>
                    </Grid>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" 
                             Color="{AppThemeBinding Light=#e2e8f0, Dark=#334155}"/>

                    <!-- Row 1: Tên danh mục (full width) -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Tên danh mục" 
                               FontSize="13" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#cbd5e1}"/>
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light=#e2e8f0, Dark=#475569}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#f8fafc, Dark=#0f172a}"
                                HeightRequest="56" Padding="16,0">
                            <Entry Placeholder="VD: Cá biển, Tôm sú, Mực ống..." 
                                   Text="{Binding NewCategoryName}"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False"
                                   BackgroundColor="Transparent"
                                   FontSize="15"
                                   VerticalOptions="Center"
                                   PlaceholderColor="{AppThemeBinding Light=#94a3b8, Dark=#475569}"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Row 2: Mô tả (full width) -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Mô tả (tùy chọn)" 
                               FontSize="13" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#cbd5e1}"/>
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light=#e2e8f0, Dark=#475569}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#f8fafc, Dark=#0f172a}"
                                HeightRequest="56" Padding="16,0">
                            <Entry Placeholder="Mô tả ngắn gọn về danh mục..." 
                                   Text="{Binding NewCategoryDescription}"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False"
                                   BackgroundColor="Transparent"
                                   FontSize="15"
                                   VerticalOptions="Center"
                                   PlaceholderColor="{AppThemeBinding Light=#94a3b8, Dark=#475569}"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" 
                             Color="{AppThemeBinding Light=#e2e8f0, Dark=#334155}"
                             Margin="0,4,0,0"/>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Text="Hủy bỏ"
                                Command="{Binding ToggleFormCommand}"
                                BackgroundColor="{AppThemeBinding Light=#f1f5f9, Dark=#334155}"
                                TextColor="{AppThemeBinding Light=#475569, Dark=#cbd5e1}"
                                CornerRadius="14"
                                HeightRequest="52"
                                Padding="32,0"
                                FontSize="15"/>
                        <Button Grid.Column="2"
                                Command="{Binding AddCategoryCommand}"
                                Style="{StaticResource SuccessButton}"
                                CornerRadius="14"
                                HeightRequest="52"
                                Padding="36,0"
                                FontSize="15"
                                FontAttributes="Bold">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsEditing}" Value="False">
                                    <Setter Property="Text" Value="💾 Lưu danh mục"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Text" Value="💾 Cập nhật"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
