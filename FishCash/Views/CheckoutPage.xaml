<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FishCash.ViewModels"
             x:DataType="viewmodels:CheckoutViewModel"
             x:Class="FishCash.Views.CheckoutPage"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBg}, Dark={StaticResource PageBgDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24" HorizontalOptions="Center" MaximumWidthRequest="480">
            
            <!-- Success Card -->
            <Border Style="{StaticResource CardFrame}" Padding="36">
                <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                    
                    <!-- Success Icon Circle -->
                    <Border StrokeShape="RoundRectangle 40"
                            StrokeThickness="0"
                            WidthRequest="80" HeightRequest="80"
                            HorizontalOptions="Center"
                            Padding="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#10b981" Offset="0.0" />
                                <GradientStop Color="#34d399" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Label Text="✓" TextColor="White" FontSize="36" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    
                    <Label Text="Thanh Toán Thành Công!" Style="{StaticResource SuccessTitle}" FontSize="24"/>
                           
                    <Label Text="{Binding CurrentOrder.TotalAmount, StringFormat='Tổng: {0:N0} VNĐ'}" 
                           Style="{StaticResource PriceLabelLarge}"
                           HorizontalOptions="Center"
                           FontSize="28"/>

                    <BoxView Style="{StaticResource Divider}" Margin="0,4"/>

                    <Label Text="Quét mã QR để thanh toán" 
                           FontSize="15" 
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" 
                           HorizontalOptions="Center"/>

                    <!-- QR Code Frame -->
                    <Border StrokeShape="RoundRectangle 14"
                            Stroke="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}"
                            StrokeThickness="2"
                            Padding="12"
                            HorizontalOptions="Center"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1e293b}">
                        <Border.Shadow>
                            <Shadow Brush="#20000000" Offset="0,4" Radius="16" Opacity="0.4"/>
                        </Border.Shadow>
                        <Image Source="{Binding QrCodeUrl}" 
                               WidthRequest="220" 
                               HeightRequest="220"
                               Aspect="AspectFit"/>
                    </Border>

                    <!-- Action Buttons -->
                    <VerticalStackLayout Spacing="12" Margin="0,10,0,0">
                        <Button Text="🖨️ In Hóa Đơn &amp; Lưu" 
                                Command="{Binding PrintInvoiceCommand}"
                                Style="{StaticResource InfoButton}"
                                Padding="20,14"
                                CornerRadius="12"/>
                                
                        <Button Text="Hoàn tất &amp; Đóng" 
                                Command="{Binding DoneCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="20,14"
                                CornerRadius="12"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
