<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FishCash.ViewModels"
             x:DataType="viewmodels:CheckoutViewModel"
             x:Class="FishCash.Views.CheckoutPage"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBg}, Dark={StaticResource PageBgDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" HorizontalOptions="Center" MaximumWidthRequest="500">
            
            <Frame Style="{StaticResource CardFrame}" Padding="30">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    
                    <Label Text="✅ Thanh Toán Thành Công!" Style="{StaticResource SuccessTitle}"/>
                           
                    <Label Text="{Binding CurrentOrder.TotalAmount, StringFormat='Tổng: {0:N0} VNĐ'}" 
                           Style="{StaticResource PriceLabelLarge}"
                           HorizontalOptions="Center"/>

                    <BoxView Style="{StaticResource Divider}"/>

                    <Label Text="Quét mã QR để thanh toán" 
                           FontSize="16" 
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" 
                           HorizontalOptions="Center"/>

                    <Frame Padding="10" 
                           BorderColor="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}" 
                           CornerRadius="10" HasShadow="False" HorizontalOptions="Center">
                        <Image Source="{Binding QrCodeUrl}" 
                               WidthRequest="250" 
                               HeightRequest="250"
                               Aspect="AspectFit"/>
                    </Frame>

                    <Button Text="🖨️ In Hóa Đơn &amp; Lưu" 
                            Command="{Binding PrintInvoiceCommand}"
                            Style="{StaticResource InfoButton}"
                            Margin="0,20,0,0"
                            Padding="15"/>
                            
                    <Button Text="Hoàn tất &amp; Đóng" 
                            Command="{Binding DoneCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="15"/>
                </VerticalStackLayout>
            </Frame>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
