<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ═══════════════════════════════════════════ -->
    <!-- FishCash Ocean Premium Theme                -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- ── Brand Colors ── -->
    <Color x:Key="Primary">#0369a1</Color>         <!-- Ocean Blue -->
    <Color x:Key="PrimaryDark">#38bdf8</Color>      <!-- Sky Blue (for dark mode) -->
    <Color x:Key="PrimaryDarkText">#f0f9ff</Color>
    <Color x:Key="Secondary">#e0f2fe</Color>        <!-- Light sky bg -->
    <Color x:Key="SecondaryDarkText">#7dd3fc</Color>
    <Color x:Key="Tertiary">#0c4a6e</Color>         <!-- Deep ocean -->
    <Color x:Key="Accent">#0d9488</Color>           <!-- Teal accent -->

    <!-- ── Semantic UI Colors ── -->
    <Color x:Key="Success">#10b981</Color>          <!-- Emerald green -->
    <Color x:Key="SuccessDark">#34d399</Color>
    <Color x:Key="Danger">#e11d48</Color>           <!-- Rose red -->
    <Color x:Key="DangerDark">#fb7185</Color>
    <Color x:Key="Warning">#f59e0b</Color>          <!-- Amber -->
    <Color x:Key="WarningDark">#fbbf24</Color>
    <Color x:Key="Info">#0ea5e9</Color>             <!-- Sky blue -->
    <Color x:Key="InfoDark">#38bdf8</Color>

    <!-- ── Price / Money ── -->
    <Color x:Key="PriceColor">#dc2626</Color>       <!-- Red for prices -->
    <Color x:Key="PriceDarkColor">#f87171</Color>

    <!-- ── Text Colors ── -->
    <Color x:Key="TextPrimary">#0f172a</Color>      <!-- Slate-900 -->
    <Color x:Key="TextPrimaryDark">#f1f5f9</Color>
    <Color x:Key="TextSecondary">#64748b</Color>    <!-- Slate-500 -->
    <Color x:Key="TextSecondaryDark">#94a3b8</Color>
    <Color x:Key="TextHeading">#1e293b</Color>      <!-- Slate-800 -->
    <Color x:Key="TextHeadingDark">#e2e8f0</Color>

    <!-- ── Surface / Background Colors ── -->
    <Color x:Key="PageBg">#f8fafc</Color>           <!-- Slate-50 -->
    <Color x:Key="PageBgDark">#0f172a</Color>       <!-- Slate-900 -->
    <Color x:Key="CardBg">White</Color>
    <Color x:Key="CardBgDark">#1e293b</Color>       <!-- Slate-800 -->
    <Color x:Key="CardBorder">#e2e8f0</Color>       <!-- Slate-200 -->
    <Color x:Key="CardBorderDark">#334155</Color>   <!-- Slate-700 -->
    <Color x:Key="HeaderBg">#0c4a6e</Color>         <!-- Deep ocean -->
    <Color x:Key="HeaderBgDark">#0c4a6e</Color>
    <Color x:Key="SidebarBg">#f1f5f9</Color>        <!-- Slate-100 -->
    <Color x:Key="SidebarBgDark">#1e293b</Color>

    <!-- ── Stat Card Accents ── -->
    <Color x:Key="StatRevenue">#0d9488</Color>      <!-- Teal-600 -->
    <Color x:Key="StatRevenueBg">#ccfbf1</Color>    <!-- Teal-100 -->
    <Color x:Key="StatRevenueBgDark">#134e4a</Color>
    <Color x:Key="StatOrders">#4f46e5</Color>       <!-- Indigo-600 -->
    <Color x:Key="StatOrdersBg">#e0e7ff</Color>     <!-- Indigo-100 -->
    <Color x:Key="StatOrdersBgDark">#312e81</Color>
    <Color x:Key="StatProducts">#7c3aed</Color>     <!-- Violet-600 -->
    <Color x:Key="StatProductsBg">#ede9fe</Color>   <!-- Violet-100 -->
    <Color x:Key="StatProductsBgDark">#4c1d95</Color>

    <!-- ── Form Input Colors ── -->
    <Color x:Key="InputBg">#f8fafc</Color>          <!-- Slate-50 -->
    <Color x:Key="InputBgDark">#1e293b</Color>      <!-- Slate-800 -->
    <Color x:Key="InputBorder">#cbd5e1</Color>      <!-- Slate-300 -->
    <Color x:Key="InputBorderDark">#475569</Color>  <!-- Slate-600 -->
    <Color x:Key="InputFocusBorder">#0369a1</Color> <!-- Primary -->

    <!-- ── Flyout Colors ── -->
    <Color x:Key="FlyoutSelectedBg">#e0f2fe</Color>     <!-- Sky-100 -->
    <Color x:Key="FlyoutSelectedBgDark">#0c4a6e</Color>
    <Color x:Key="FlyoutItemText">#334155</Color>        <!-- Slate-700 -->
    <Color x:Key="FlyoutItemTextDark">#cbd5e1</Color>

    <!-- ── Gradient Colors ── -->
    <Color x:Key="GradientStart">#0369a1</Color>    <!-- Ocean Blue -->
    <Color x:Key="GradientMid">#0284c7</Color>      <!-- Sky-600 -->
    <Color x:Key="GradientEnd">#0ea5e9</Color>      <!-- Sky-500 -->

    <!-- ── Base Colors (kept for Styles.xaml compatibility) ── -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#0369a1</Color>          <!-- Remapped to Primary -->
    <Color x:Key="MidnightBlue">#0c4a6e</Color>    <!-- Deep ocean -->
    <Color x:Key="OffBlack">#0f172a</Color>         <!-- Slate-900 -->

    <!-- ── Gray Scale ── -->
    <Color x:Key="Gray100">#f1f5f9</Color>          <!-- Slate-100 -->
    <Color x:Key="Gray200">#e2e8f0</Color>          <!-- Slate-200 -->
    <Color x:Key="Gray300">#cbd5e1</Color>          <!-- Slate-300 -->
    <Color x:Key="Gray400">#94a3b8</Color>          <!-- Slate-400 -->
    <Color x:Key="Gray500">#64748b</Color>          <!-- Slate-500 -->
    <Color x:Key="Gray600">#475569</Color>          <!-- Slate-600 -->
    <Color x:Key="Gray900">#1e293b</Color>          <!-- Slate-800 -->
    <Color x:Key="Gray950">#0f172a</Color>          <!-- Slate-900 -->

    <!-- ── Brushes ── -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>